# ---------------------------------------------------------------------------
# CSMJU Lab Booking - example environment
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

PORT=3003

# This subsystem owns its OWN database. It must NOT point at the Core Hub DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/lab_booking_db

# Core Hub API (identity provider): JWKS and token checks. On the shared dev
# server this is a tunnel URL - set it in .env only, never commit it.
CORE_HUB_URL=http://localhost:3000

# Core Hub public key set (public material only - never the private key)
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json

# Immutable Core Hub JWT contract
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# JWKS cache behaviour (milliseconds)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000

# Subsystem identity. Cookie names are derived from SUBSYSTEM_ID:
# <id>_access_token and <id>_sso_state, with "-" turned into "_".
SUBSYSTEM_ID=csmju-lab-booking
SUBSYSTEM_NAME=CSMJU Lab Booking

# Clock skew tolerance when validating exp/iat (seconds)
JWT_CLOCK_TOLERANCE_SEC=5

# ---- Central SSO -----------------------------------------------------------
# Core Hub's WEB app, where GET /auth/login sends the browser. It must be the
# address the browser uses (not a Docker-internal name), spelled exactly as the
# user signed in there: localhost and 127.0.0.1 are different sites to cookies.
CORE_HUB_WEB_URL=http://localhost:3100
# Lifetime of the state cookie (seconds, at most 600) - time to type a password.
SSO_STATE_TTL_SEC=600
# Where the callback lands when there is no usable ?next= — the web app home page.
SSO_POST_LOGIN_REDIRECT=/
# The callback_url registered in Core Hub MUST be <this service>/auth/callback.
# Never register /auth/login there: it only redirects back to Core Hub.

# ---- Proxy -----------------------------------------------------------------
# Empty = no proxy in front: request.ip is the socket address and a forged
# X-Forwarded-For is ignored. Dev server behind Cloudflare: loopback, uniquelocal
TRUST_PROXY=

# ---- Rate limit layer 1: per address, before the token is checked ----------
# Loose on purpose: a lab of 50 people behind one NAT address shares it.
THROTTLE_IP_BURST_TTL_MS=10000
THROTTLE_IP_BURST_LIMIT=600
THROTTLE_IP_SUSTAINED_TTL_MS=60000
THROTTLE_IP_SUSTAINED_LIMIT=3000

# ---- Rate limit layer 2: per verified user, after the token is checked -----
THROTTLE_USER_BURST_TTL_MS=10000
THROTTLE_USER_BURST_LIMIT=100
THROTTLE_USER_SUSTAINED_TTL_MS=60000
THROTTLE_USER_SUSTAINED_LIMIT=600

# ---- Database pool and timeout ceilings ------------------------------------
# Prisma 7 uses a node-postgres adapter, so connection_limit / pool_timeout in
# DATABASE_URL are ignored - these are the knobs that actually apply.
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# TEMPORARY: รันโดยไม่มี Core Hub (เครื่อง developer เท่านั้น — production ห้ามตั้ง, ระบบจะไม่ยอมบูต)
# student | alumni | staff | admin — ทุก request จะเป็นผู้ใช้ทดสอบคนนี้ ไม่ตรวจ token
# ใช้ staff เพื่อเพิ่ม/ลบตารางเรียนได้ · เปิดไว้ = ไม่ผ่าน conformance · เปลี่ยนแล้วต้อง restart backend
# LOCAL_TEST_ROLE=staff

# Server time zone (deployment.md 4.2) — room status and booking rules run on Thai time
TZ=Asia/Bangkok
